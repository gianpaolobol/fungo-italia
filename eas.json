{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "simulator": true
      },
      "node": "24.3.0"
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "node": "24.3.0"
    },
    "iphone-library": {
      "distribution": "internal",
      "channel": "preview",
      "node": "24.3.0",
      "ios": {
        "simulator": false
      }
    }
  }
}
