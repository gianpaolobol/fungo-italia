{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "simulator": true
      },
      "node": "24.3.0"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PROJECT_ID": "b65af584-739f-4ef0-8fe5-6c0ba692c088"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "node": "24.3.0"
    },
    "iphone-library": {
      "distribution": "internal",
      "channel": "preview",
      "node": "24.3.0",
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
