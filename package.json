{
  "name": "fungo-italia",
  "version": "1.1.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "start": "npm run prepare:data && expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prepare:data": "node scripts/prepare-data.mjs",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform all",
    "validate:release": "node scripts/release-readiness.mjs --strict",
    "test:release-readiness": "node scripts/release-readiness.test.mjs",
    "export:release-readiness": "node scripts/release-readiness.mjs --write",
    "eas-build-post-install": "npm run prepare:data"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.2",
    "expo-constants": "~58.0.13",
    "expo-media-library": "~58.0.0",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "58.0.3",
    "expo-updates": "58.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.3",
    "react-native-safe-area-context": "5.9.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "5.9.3"
  },
  "overrides": {
    "react-native": "$react-native"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          ".*"
        ]
      },
      "nativeModulesDir": "./modules"
    }
  }
}
